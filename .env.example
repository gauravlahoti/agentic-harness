# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Only src/agentic_harness/config.py reads these values.

# Gemini access (Decisions.md D-08). Default: AI Studio API key.
GEMINI_API_KEY=

# Optional settings
# HARNESS_BACKEND=gemini_api          # or: agent_platform
# HARNESS_MODEL=gemini-3.8-flash
# GOOGLE_CLOUD_PROJECT=               # agent_platform only
# GOOGLE_CLOUD_LOCATION=global        # agent_platform only
